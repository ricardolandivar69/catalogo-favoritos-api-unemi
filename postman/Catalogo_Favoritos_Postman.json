{
  "info": {
    "name": "Catalogo con Favoritos - UNEMI - Pruebas",
    "description": "Ejecutar en orden despues de iniciar PostgreSQL, crear administrador y cargar cinco productos. Solo datos ficticios. No exportar el entorno que ya tiene tokens reales. Las pruebas 32-34 requieren pasos manuales descritos en README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Catalogo publico (5 productos)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Al menos cinco productos', () => pm.expect(j.productos.length).to.be.at.least(5)); pm.environment.set('idSemilla', String(j.productos[0].id));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Filtro publico por categoria",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos?categoria=Computacion"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Filtro correcto', () => j.productos.forEach(p => pm.expect(p.categoria).to.equal('Computacion')));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Producto inexistente - 404",
