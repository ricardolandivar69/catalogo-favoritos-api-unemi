    {
      "name": "04 - Registrar usuario A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana Ejemplo\",\n  \"correo\": \"{{correoA}}\",\n  \"password\": \"{{passwordA}}\",\n  \"rol\": \"administrador\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('correoA')) pm.environment.set('correoA', 'a_' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Publico nunca es admin', () => { pm.expect(j.usuario.rol).to.equal('usuario'); pm.expect(j.usuario).to.not.have.property('password_hash'); pm.expect(j.usuario).to.not.have.property('password'); }); pm.environment.set('idA', String(j.usuario.id));"
            ]
          }
        }
      ]
    },
